+def verify_identity(identity, root):
+    spec=FROZEN_IDENTITIES[identity]
+    path=Path(root)/spec['path']
+    if path.is_symlink() or sha256_file(path)!=spec['sha256']:
+        raise ValueError(f'Frozen identity hash mismatch: {identity}')
+    return path
