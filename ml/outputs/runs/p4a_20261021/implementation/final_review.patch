+                  rss_after_load_bytes=psutil.Process().memory_info().rss, threadpools=threadpool_info(),
+                  tensor_sha256=hashlib.sha256(bank.tobytes()).hexdigest())
+    load_bank(run / 'validation')  # Byte check after all worker calls.
+    return report
