+@pytest.mark.parametrize('available_gib,allowed',[(6,True),(3,False)])
+def test_user_relaxed_ram_policy_allows_six_gib_but_keeps_lower_guard(core,tmp_path,monkeypatch,available_gib,allowed):
+    from types import SimpleNamespace
+    from ml.experiments import run_p4
+    protocol=json.loads((run_p4.ROOT/'ml/configs/p4_protocol.json').read_text())
+    monkeypatch.setattr(core.psutil,'virtual_memory',lambda:SimpleNamespace(available=available_gib*1024**3))
+    def startup():
+        return core.BudgetSupervisor(tmp_path/'budget',min_available_ram=protocol['budgets']['minimum_available_ram_bytes'])
+    if allowed:
+        supervisor=startup()
+        assert supervisor.minimum_ram==4*1024**3 and not supervisor.stopped
+    else:
+        with pytest.raises(core.BudgetExceeded,match='INSUFFICIENT_STARTUP_RESOURCES'):startup()
