+    page=page.replace('GUIDE',html.escape(guide)).replace('OPTIONS',''.join(
+        f'<option>{x}</option>' for x in CHOICES)).replace('PAYLOAD',payload)
+    (directory/'review.html').write_text(page)
+    return manifest
