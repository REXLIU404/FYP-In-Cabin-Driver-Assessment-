await (async (page) => {
  const sessions = await (await page.request.get("http://127.0.0.1:8011/api/sessions")).json();
  const original = sessions[0];
  await page.getByRole("button", {name:"Live Monitor", exact:true}).click();
  await page.getByRole("heading", {name:"Assessment unavailable", exact:true}).waitFor();
  await page.screenshot({path:"output/playwright/paused-stale.png", fullPage:true});
  let pending = page.waitForResponse(r => r.url().endsWith("/infer") && r.status() === 201);
  await page.getByRole("button", {name:"Start Monitoring", exact:true}).click();
  const resumed = await (await pending).json();
  if (resumed.session_id !== original.id || resumed.window_id <= original.total_windows) throw new Error("Resume lost sequence");
  pending = page.waitForResponse(r => r.url().endsWith("/infer") && r.status() === 201 && !r.url().includes(original.id));
  await page.getByRole("button", {name:"New Session", exact:true}).click();
  const created = await (await pending).json();
  if (created.window_id !== 1) throw new Error("New session counter did not start at 1");
  await page.getByRole("button", {name:"Stop Camera", exact:true}).click();
  let missing;
  for (let i=0;i<5;i++) {
    missing = await (await page.waitForResponse(r => r.url().endsWith("/infer") && r.status() === 201)).json();
    if(missing.modality_freshness.vision === "missing") break;
  }
  if (missing.modality_freshness.vision !== "missing" || missing.SystemHealth !== "DEGRADED") throw new Error("Stopped camera not marked missing");
  await page.screenshot({path:"output/playwright/camera-stopped.png", fullPage:true});
  await page.getByRole("button", {name:"Pause", exact:true}).click();
  await page.getByRole("button", {name:"Refresh saved sessions", exact:true}).click();
  await page.getByRole("combobox", {name:"Saved live sessions", exact:true}).selectOption(original.id);
  await page.getByRole("button", {name:"Signal Inspector", exact:true}).click();
  await page.getByRole("button", {name:"Window 1", exact:true}).click();
  await page.getByRole("button", {name:"Unflag", exact:true}).waitFor();
  const exportResult = await (await page.request.get("http://127.0.0.1:8011/api/sessions/"+original.id+"/export")).json();
  if (!exportResult.records.find(r=>r.window_id===1).flagged) throw new Error("Historical flag lost");
  return {check:"pause_resume_new_camera_loss_history", original_id:original.id, resumed_window:resumed.window_id, new_session:created.session_id, degraded:missing, original_records:exportResult.records.length};
})(page);
