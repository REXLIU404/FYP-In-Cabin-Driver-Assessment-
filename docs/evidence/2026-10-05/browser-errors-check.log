  await page.getByRole("button",{name:"Start Monitoring",exact:true}).click();
  await page.getByRole("alert").filter({hasText:"Test model outage"}).waitFor();
  if(await page.getByRole("button",{name:"Start Monitoring",exact:true}).isDisabled()) throw new Error("Failed inference stayed running");
  if(await page.getByRole("combobox",{name:"Data mode",exact:true}).inputValue()!=="LIVE_MODEL_RUNTIME") throw new Error("Silent replay fallback");
  const pending=page.waitForResponse(r=>r.url().endsWith("/infer") && r.status()===201);
  await page.getByRole("button",{name:"Start Monitoring",exact:true}).click();
  const recovered=await(await pending).json();
  await page.getByText("Monitoring active",{exact:true}).waitFor();
  await page.getByRole("button",{name:"Pause",exact:true}).click();
  await page.getByRole("button",{name:"Stop Camera",exact:true}).click();
  return {check:"replay_timer_and_no_fallback_recovery", replay_min_windows:2, provider:recovered.provenance.provider, telemetry_source:recovered.provenance.telemetry_source, session_id:recovered.session_id};
})(page);
